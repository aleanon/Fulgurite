/* The showcase's sheet, as .lss -- M61/T61.4 (docs/plan-lss.md).

   NOT what the showcase runs: `stylesheet()` in src/main.rs is, with the
   reasoning for every rule beside it. This file mirrors it rule for rule,
   and `the_lss_mirror_is_the_hand_written_sheet` holds the two equal, so
   this is the accept direction of include_lss!'s tree checks on a real,
   49-rule sheet (every #id and .class below is checked against `Screen`
   at compile time) and K2's larger measurement. The plan's §4: the
   showcase moves only if the tally's pilot shows the path is clean. */

@tokens {
    hairline: #dfe4edff;
    ghost: #eaeffbff;
    panel-h: 560px;
    row-h: 30px;
}

Screen { background: $page; }
#header { background: $surface; padding: 20px 28px 18px; }
#title { color: $text; font-size: 20px; font-weight: 700; }
#select-trigger {
    width: 300px;
    background: $control;
    color: $text;
    border-radius: 8px;
    font-size: 15px;
    padding: 9px 14px;
}
#blurb { color: $muted; font-size: 13px; }
#readout { color: $accent; font-size: 13px; font-weight: 600; }
#hr { background: $hairline; }
Stage { height: fill; }
#st, #sb { height: fill; }
#sl, #sr { width: fill; }
#select-menu { width: 300px; height: $panel-h; background: $surface; border-radius: 10px; }

/* `btn()` in main.rs, spelled out: .lss has no mixins. */
#d_button_a {
    hover-dim: 0.07; width: shrink; height: shrink; border-radius: 8px;
    font-size: 15px; font-weight: 600; padding: 10px 18px;
    background: $accent; color: $on-accent;
}
#d_button_b {
    hover-dim: 0.07; width: shrink; height: shrink; border-radius: 8px;
    font-size: 15px; font-weight: 600; padding: 10px 18px;
    background: $surface; color: $text;
}
#d_button_c {
    hover-dim: 0.07; width: shrink; height: shrink; border-radius: 8px;
    font-size: 15px; font-weight: 600; padding: 10px 18px;
    background: $ghost; color: $accent;
}
#d_card_a { width: 280px; }
#d_card_title { font-weight: 600; }
#d_card_go, #tooltip-content {
    hover-dim: 0.07; width: shrink; height: shrink; border-radius: 8px;
    font-size: 15px; font-weight: 600; padding: 10px 18px;
    background: $accent; color: $on-accent;
}
#d_textinput_a {
    width: 260px; height: 38px;
    background: $control; color: $text;
    border-width: 1px; border-color: $muted;
    border-radius: 8px; font-size: 15px; padding: 9px 12px;
}
#d_textarea_a {
    width: 260px; height: 96px;
    background: $control; color: $text;
    border-width: 1px; border-color: $muted;
    border-radius: 8px; font-size: 15px; padding: 9px 12px;
}
.pair-label { color: $text; font-size: 15px; }
#d_slider_a { width: 280px; }
#d_scrollview_a { width: 260px; height: 180px; }
#d_range_a { width: 280px; }
#d_search_a { width: 320px; }
textinput {
    width: 220px; height: 36px;
    background: $control; color: $text;
    border-width: 1px; border-color: $muted;
    border-radius: 8px; padding: 8px 12px;
}
DWrap { width: 260px; }
DGrid { width: 420px; }
#d_split_a { width: 360px; height: 140px; }
DAccordion { width: 320px; }
.veil-body { background: $surface; padding: 20px; border-radius: 12px; box-shadow: 12px; }
.veil-title { font-weight: 600; }
.veil-go {
    hover-dim: 0.07; width: shrink; height: shrink; border-radius: 8px;
    font-size: 15px; font-weight: 600; padding: 10px 18px;
    background: $accent; color: $on-accent;
}
#d_menu_a { height: 40px; }
#d_datagrid_a { height: 220px; }
#d_tree_a { height: 200px; }
#d_panegrid_a { height: 260px; }
#d_tabs_a, #d_bottomnav_a, #d_appbar_a { width: 420px; }
#d_rail_a { height: 260px; }
#d_pull_a { width: 280px; height: 120px; }
#d_progress_a, #d_divider_a { width: 280px; }
#d_skeleton_a { width: 180px; height: 18px; }
#d_skeleton_b { width: 120px; height: 18px; }
button {
    width: fill; height: $row-h;
    background: #00000000; color: $text;
    font-size: 13px; border-radius: 0px; hover-dim: 0;
    padding: 6px 10px 6px 14px;
}
